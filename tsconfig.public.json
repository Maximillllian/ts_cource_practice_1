{
    "extends": "./tsconfig.json",
    "compilerOptions": {
      "composite": true,
      "lib": ["DOM", "DOM.Iterable", "ES2022"],
  
      "target": "ES2020",
  
      "module": "ESNext",
      "moduleResolution": "bundler",
  
      "baseUrl": ".",
      "paths": {
        "src/types/*": ["src/types/*"]
      },
  
      "outDir": "./dist/public",
      "rootDir": "."
    },
    "include": ["public/**/*", "src/types/**/*"],
    "exclude": ["node_modules", "dist"]
  }